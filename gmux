def merge(repo, remote_name='origin', branch='master'):
    """
    Performs a git pull equivalent: fetches the remote and updates the local branch.

    Args:
        repo: pygit2.Repository instance
        remote_name: Name of the remote (e.g., 'origin')
        branch: Name of the branch to pull (e.g., 'master')

    Returns:
        True if the local branch is up to date, fast-forwarded, or merged
        cleanly; False if the remote branch is missing or a conflict needs
        manual resolution.
    """

    # 1. Get the remote tracking branch reference
    remote_branch_name = f'refs/remotes/{remote_name}/{branch}'
    try:
        remote_commit_id = repo.lookup_reference(remote_branch_name).target
    except KeyError:
        print(f"'{remote_branch_name}': no such remote branch")
        return False
    remote_commit = repo.get(remote_commit_id)

    # 2. Analyze if and how we can merge
    merge_result, _ = repo.merge_analysis(remote_commit_id)

    # 3. Case 1: Already up to date
    if merge_result & GIT_MERGE_ANALYSIS_UP_TO_DATE:
        #print("Already up to date.")
        return True

    # 4. Case 2: Fast-forward possible
    elif merge_result & GIT_MERGE_ANALYSIS_FASTFORWARD:
        print("Fast-forwarding...")
        # Move the branch reference and HEAD to the remote commit
        repo.checkout_tree(remote_commit)
        branch_ref = repo.lookup_reference(f'refs/heads/{branch}')
        branch_ref.set_target(remote_commit_id)
        repo.head.set_target(remote_commit_id)
        #print(f"Updated to {remote_commit_id.hex}")
        return True

    # 5. Case 3: True merge required
    elif merge_result & GIT_MERGE_ANALYSIS_NORMAL:
        print("Merging...")
        # Perform the merge
        repo.merge(remote_commit_id)

        # Check for conflicts
        if repo.index.conflicts:
            print("Conflicts detected! Please resolve them manually.")
            # You can iterate through conflicts if needed:
            # for conflict in repo.index.conflicts:
            #     print(f"Conflict in: {conflict[0].path}")
            return False

        # No conflicts: commit the merge
        user = repo.default_signature
        tree = repo.index.write_tree()
        repo.create_commit(
            'HEAD',
            user,
            user,
            f"Merge remote branch '{remote_name}/{branch}'",
            tree,
            [repo.head.target, remote_commit_id]
        )
        # Clean up merge state
        repo.state_cleanup()
        print("Merge completed successfully.")
        return True

    else:
        raise RuntimeError("Unknown merge analysis result")


# Auth for ssh:// / git@host:path links. libgit2 doesn't consult
# ~/.ssh/config or an agent on its own like the git CLI does, so this has
# to be handed to pygit2 explicitly on every clone/fetch. Only ssh-agent
# auth is supported; HTTPS links are unaffected since this callback is
# only invoked when the transport actually asks for credentials.
def ssh_credentials(url, username_from_url, allowed_types):
    return pygit2.KeypairFromAgent(username_from_url or "git")

def remote_callbacks():
    return pygit2.RemoteCallbacks(credentials=ssh_credentials)


class Log:
    def __init__(self):
        pass

    def err(self, fmt, *arg):
        print(f"{pgname}: " + fmt % arg, file=sys.stderr)
        return 1

    def info(self, fmt, *arg):
        print(f"{pgname}: " + fmt % arg)
        return 0

    def debug(self, fmt, *arg):
        global ISDEBUG

        if ISDEBUG == False:
            return 0
        print(f"{pgname}: " + fmt % arg)
        return 0

class Branch(Log):
    def __init__(self, pattern):
        self.branch = None
        self.pattern = pattern
        self.branch_stored = None

    def generate(self, units, prefix, tasktype):
        delimiters = r'[/_-]+'
        pattern = copy.deepcopy(self.pattern)

        for obj in units:
            #print("## obj", obj, "-", units[obj].upper())
            pattern = pattern.replace(obj.upper(), units[obj])

        # TODO: hotfix - replace whitespaces with underscore in description
        pattern = pattern.replace(" ", "_")

        # HOTFIX: replace prefix as well
        pattern = pattern.replace("PREFIX", prefix)
        # HOTFIX: replace task type as well
        pattern = pattern.replace("TYPE", tasktype)

        #print("--> new pattern", pattern)
        return pattern # i.e. newly generated branch

    def get(self):
        return self.branch

class Repo(Log):
    def __init__(self, config, path):
        self.log = Log()
        self.config = config
        self.path = path + "/.tec/pgn/gmux/"

        self.clone()

    def clone(self):
        for cfg in self.config['repos']:
            repodir = "/".join([self.path + cfg['name']])
            if not os.path.exists(repodir):
                repo = pygit2.clone_repository(cfg['link'], repodir, callbacks=remote_callbacks())
            else:
                repo = pygit2.Repository(repodir)

            for submodule in repo.submodules:
                submodule.init()
                submodule.update(init=True, callbacks=remote_callbacks())
        return True

    def submodules(self, cfg):
        repo = pygit2.Repository(self.path + cfg['name'])
        return [sm.path for sm in repo.submodules]

    # A submodule's own default branch: an explicit override from
    # cfg['modules'] wins; otherwise ask the submodule's own remote what
    # its default branch is (a submodule commonly points at a different
    # repo than its parent, so the parent's default branch is not a safe
    # assumption); falling back to the parent's default branch only if
    # the submodule has no discoverable remote HEAD (e.g. offline clone).
    def submodule_default_branch(self, cfg, subpath, override):
        if override is not None:
            return override
        reponame = "/".join([cfg['name'], subpath])
        repo = pygit2.Repository(self.path + reponame)
        return self.branch_get_default(repo) or cfg['branch']

    # Build a cfg-like dict per submodule, with 'name' resolved to its path
    # relative to self.path and 'branch' resolved via submodule_default_branch(),
    # so submodules can be driven through the same repo methods as top-level repos.
    def submodule_cfgs(self, cfg):
        modules = { m['name']: m for m in cfg.get('modules', []) }
        return [
            {
                **cfg,
                'name': "/".join([cfg['name'], subpath]),
                'branch': self.submodule_default_branch(cfg, subpath, modules.get(subpath, {}).get('branch')),
                'subpath': subpath,
            }
            for subpath in self.submodules(cfg)
        ]

    # After a submodule's branch has moved, the parent repo's tree still
    # pins the old submodule commit (git reports it as "modified content").
    # Stage and commit the new pointer on whatever branch the parent
    # currently has checked out, so the parent doesn't stay dirty forever.
    def commit_submodule_pointer(self, cfg, subcfg):
        reponame = cfg['name']
        subpath = subcfg['subpath']
        repo = pygit2.Repository(self.path + reponame)

        if repo.status_file(subpath) == 0:
            return True

        try:
            repo.index.add(subpath)
            repo.index.write()
            tree = repo.index.write_tree()
            user = repo.default_signature
            repo.create_commit(
                'HEAD', user, user,
                f"gmux: bump '{subpath}' submodule pointer",
                tree, [repo.head.target],
            )
        except pygit2.GitError as e:
            self.log.err("'%s': could not commit submodule pointer: %s", reponame, e)
            return False
        return True

    # Stage all changes in the repo and commit them, with the commit
    # message built from cfg['commitpatt'] (falling back to a bare
    # MSG pattern if the repo has none configured).
    def commit(self, cfg, taskid, part, message):
        reponame = cfg['name']
        repo = pygit2.Repository(self.path + reponame)
        pattern = cfg.get('commitpatt', "MSG")
        commit_message = pattern.replace("ID", taskid).replace("PART", part).replace("MSG", message)

        try:
            repo.index.add_all()
            repo.index.write()
            tree = repo.index.write_tree()
            user = repo.default_signature
            repo.create_commit(
                'HEAD', user, user, commit_message, tree, [repo.head.target],
            )
        except pygit2.GitError as e:
            self.log.err("'%s': could not commit changes: %s", reponame, e)
            return False
        return True

    def symlink(self, cfg, dst, taskid):
        dst = "/".join([dst, taskid])
        repo_src = self.path + cfg['name']
        repo_dst = "/".join([dst, cfg['name']])
        if not os.path.exists(repo_src):
            self.log.err("repo not cloned yet")
            return False
        elif not os.path.islink(repo_dst):
            os.symlink(repo_src, repo_dst)
        return True

    def rebase(self, cfg, target_branch_name, feature_branch_name):
        """
        Rebase a feature branch onto a target branch.

        Args:
            cfg: repo config entry (used to locate the repo on disk)
            target_branch_name: Name of the branch to rebase onto (e.g., "main")
            feature_branch_name: Name of the feature branch to rebase

        Returns:
            True on success (including the no-op case where the feature
            branch is already up to date); False on error or conflict,
            in which case the repo is left on its original branch/commit.
        """
        reponame = cfg['name']
        repo = pygit2.Repository(self.path + reponame)

        target_branch = repo.branches.get(target_branch_name)
        feature_branch = repo.branches.get(feature_branch_name)
        if target_branch is None:
            self.log.err("'%s': no such branch '%s'", reponame, target_branch_name)
            return False
        if feature_branch is None:
            self.log.err("'%s': no such branch '%s'", reponame, feature_branch_name)
            return False

        # Get the common ancestor (merge base)
        merge_base = repo.merge_base(feature_branch.target, target_branch.target)
        if merge_base is None:
            self.log.err("'%s': no common ancestor between '%s' and '%s'",
                          reponame, feature_branch_name, target_branch_name)
            return False

        if merge_base == target_branch.target:
            self.log.debug("'%s': '%s' is already up-to-date with '%s'",
                            reponame, feature_branch_name, target_branch_name)
            return True

        # Get the list of commits to replay (feature commits not in target)
        commits_to_replay = []
        for commit in repo.walk(feature_branch.target, pygit2.GIT_SORT_TOPOLOGICAL):
            if commit.id == merge_base:
                break
            commits_to_replay.append(commit)
        commits_to_replay.reverse()  # Oldest first

        self.log.debug("'%s': rebasing %d commit(s) from '%s' onto '%s'",
                        reponame, len(commits_to_replay), feature_branch_name, target_branch_name)

        # Save current HEAD so we can restore it if anything goes wrong
        original_ref = repo.head.name

        # Move to a detached HEAD at the target branch's tip so replayed
        # commits don't touch target_branch's ref until we're done.
        repo.set_head(target_branch.target)
        repo.reset(target_branch.target, pygit2.GIT_RESET_HARD)
        new_head = target_branch.target

        for commit in commits_to_replay:
            try:
                repo.cherrypick(commit.id)
            except pygit2.GitError as e:
                self.log.err("'%s': git error while replaying commit '%s': %s",
                              reponame, str(commit.id)[:8], e)
                repo.state_cleanup()
                repo.checkout(original_ref, strategy=pygit2.GIT_CHECKOUT_FORCE)
                return False

            if repo.index.conflicts:
                self.log.err("'%s': conflict while replaying commit '%s'",
                              reponame, str(commit.id)[:8])
                repo.state_cleanup()
                repo.checkout(original_ref, strategy=pygit2.GIT_CHECKOUT_FORCE)
                return False

            new_head = repo.create_commit(
                'HEAD',
                commit.author,
                repo.default_signature,
                commit.message,
                repo.index.write_tree(),
                [new_head],
            )
            repo.state_cleanup()

        feature_branch.set_target(new_head)
        repo.checkout(feature_branch, strategy=pygit2.GIT_CHECKOUT_FORCE)
        self.log.debug("'%s': successfully rebased '%s' onto '%s'",
                        reponame, feature_branch_name, target_branch_name)
        return True

    # Fast-forward cfg['branch'] (the default branch) to from_branch_name's
    # tip. Meant to be called right after a successful rebase(), where the
    # default branch is guaranteed to be an ancestor of the rebased branch.
    def branch_fastforward(self, cfg, from_branch_name):
        reponame = cfg['name']
        dst_name = cfg['branch']
        repo = pygit2.Repository(self.path + reponame)

        dst_branch = repo.branches.get(dst_name)
        src_branch = repo.branches.get(from_branch_name)
        if dst_branch is None or src_branch is None:
            self.log.err("'%s': missing branch while fast-forwarding", reponame)
            return False

        if dst_branch.target == src_branch.target:
            return True
        if not repo.descendant_of(src_branch.target, dst_branch.target):
            self.log.err("'%s': '%s' is not a fast-forward of '%s'",
                          reponame, from_branch_name, dst_name)
            return False

        dst_branch.set_target(src_branch.target)
        return True

    def has_uncommited_changes(self, cfg):
        repo = pygit2.Repository(self.path + cfg['name'])
        status = repo.status()
        return len(status) > 0

    def fetch(self, cfg, remote_name="origin"):
        repo = pygit2.Repository(self.path + cfg['name'])
        self.log.info("fetching repo '%s'", cfg["name"])
        try:
            remote = repo.remotes[remote_name]
            remote.fetch(callbacks=remote_callbacks())
        except (KeyError, pygit2.GitError) as e:
            self.log.err("'%s': could not fetch from '%s': %s", cfg['name'], remote_name, e)
            return False
        return True

    def merge(self, cfg, remote_name="origin"):
        repo = pygit2.Repository(self.path + cfg['name'])
        self.log.debug("'%s': merge repo", cfg['name'])
        return merge(repo, remote_name, cfg['branch'])

    # Get default branch name from remote
    def branch_get_default(self, repo):
        remote_head = repo.references.get("refs/remotes/origin/HEAD")
        if remote_head:
            default_branch = remote_head.resolve().shorthand.replace('origin/', '')
            return default_branch
        return None

    # TODO: find a way to join this function and branch_switch()
    def branch_switch_default(self, cfg):
        status = True
        reponame = cfg['name']
        branch = cfg['branch']

        # TODO: switch branch in submodules as well
        # TODO: let not nonexisting brach to break the loop
        try:
            branch_name = branch
            repo = pygit2.Repository(self.path + reponame)

            # TODO: check that repo has no uncommited changes
            if branch_name not in repo.branches:
                self.log.err("'%s': no such default branch in repo '%s'", branch_name, reponame)
                status = False
            elif branch_name == repo.head.shorthand:
                self.log.info("'%s': already on default branch '%s'", reponame, branch_name)
            else:
                repo.checkout(repo.branches[branch_name])
        except pygit2.GitError as e:
            self.log.err("git error: %s", reponame)
            status = False
        return status

    def branch_switch(self, cfg, branch_name):
        status = True
        reponame = cfg['name']
        branch = cfg['branch']
        # TODO: switch branch in submodules as well
        # TODO: let not nonexisting brach to break the loop
        try:
            repo = pygit2.Repository(self.path + reponame)

            # TODO: check that repo has no uncommited changes
            if cfg["branch"] not in repo.branches:
                self.log.err("'%s': no such base branch in repo '%s'", branch, reponame)
                status = False
            elif branch_name not in repo.branches:
                self.log.err("'%s': no such task branch in repo '%s'", branch_name, reponame)
                status = False
            elif branch_name == repo.head.shorthand:
                self.log.debug("'%s': already on branch '%s'", reponame, branch_name)
            else:
                repo.checkout(repo.branches[branch_name])
        except pygit2.GitError as e:
            self.log.err("'%s': git error: %s", reponame, e)
            status = False
        return status

    def branch_remove(self, cfg, branch_name):
        status = True
        repo = pygit2.Repository(self.path + cfg['name'])
        if branch_name is None:
            self.log.err("'%s': no task branch stored yet, nothing to remove", cfg['name'])
            return False
        if branch_name in repo.branches:
            if self._has_uncommited_changes(cfg['name']) == False:
                repo.checkout(repo.branches[cfg['branch']])
                repo.branches.delete(branch_name)
            else:
                self.log.err("%s: repo has uncommited changes", cfg['name'])
                status = False
        else:
            self.log.err("'%s': no such branch in repo '%s'", branch_name, cfg['name'])
            status = False
        return status


    def branch_update(self, cfg, oldbranch, newbranch):
        reponame = cfg['name']
        branch = cfg['branch']

        if oldbranch == newbranch:
            if self._has_uncommited_changes(reponame) == True:
                self.log.err(f"{reponame}: has uncommited changes")
                return False
            elif self._branch_exist(reponame, oldbranch) == False:
                return self._branch_create(reponame, oldbranch, branch)
            return True
        elif oldbranch is not None:
            return self._branch_rename(reponame, oldbranch, newbranch)
        elif self._branch_exist(reponame, newbranch) == False:
            return self._branch_create(reponame, newbranch, branch)
        return True

    def _has_uncommited_changes(self, reponame):
        repo = pygit2.Repository(self.path + reponame)
        return bool(repo.status())

    def _branch_exist(self, reponame, branchname):
        repo = pygit2.Repository(self.path + reponame)
        return branchname in repo.branches

    # Create local branch from remote branch.
    # It is usefull when cloning new repo
    def __create_branch_from_remote(self, reponame, branch_to_create):
        repo = pygit2.Repository(self.path + reponame)
        remote_ref_name = f"origin/{branch_to_create}"

        if branch_to_create in repo.branches.local:
            # Branch already exits, do nothing
            return True
        elif remote_ref_name in repo.branches.remote:
            remote_ref = repo.branches.remote[remote_ref_name]
            commit = repo.get(remote_ref.target)
            repo.branches.create(branch_to_create, commit)
            return True
        # Branch not found, return False
        return False

    def _branch_create(self, reponame, new_branch_name, src_branch_name):
        repo = pygit2.Repository(self.path + reponame)
        if self.__create_branch_from_remote(reponame, src_branch_name) is False:
            print(f"'{src_branch_name}': could not find it neither locally nor remotely in {reponame}")
            return False
        src_branch = repo.branches[src_branch_name]
        new_branch = repo.branches.local.create(new_branch_name, repo[src_branch.target])
        return True

    def _branch_rename(self, reponame, old_branch, new_branch):
        repo = pygit2.Repository(self.path + reponame)
        branch = repo.branches.local[old_branch]
        branch.rename(new_branch)
        return True

class Config(Log):
    def __init__(self):
        self.config = None
        fname = self._get_config_file()

        if fname == None:
            self.err("no config file is found")
            sys.exit(1)
        with open(fname) as file:
            self.config = json.load(file)

    def _get_defaults(self, cfg):
        cfg.setdefault("repos", [])
        cfg.setdefault("prefix", "gmux")
        cfg.setdefault("type", "feature")
        cfg.setdefault("branchpatt", "TYPE/PREFIX-ID_DESC_DATE")
        return cfg

    def _get_config_file(self):
        paths = [
            "/".join([os.environ["HOME"], ".tec/pgn/gmux.json"]),
            "/".join([os.environ["HOME"], ".config/tec/pgn/gmux.json"]),
        ]
        for cfg in paths:
            if os.path.exists(cfg):
                return cfg
        return None

    def get(self, env):
        return self._get_defaults(self.config.get(env, {}))


class Unit:
    def __init__(self, pathbase):
        self.units = {}
        self.unitpgn = {}
        self.pathbase = pathbase
        self._bin_suffix_path = ".tec/units"
        self._pgn_suffix_pathdir = ".tec/pgn"
        self._pgn_suffix_path = "/".join([self._pgn_suffix_pathdir, "gmux"])

    def make_dir(self, taskid):
        dirname = "/".join([self.pathbase, taskid, self._pgn_suffix_pathdir])
        if not os.path.exists(dirname):
            os.mkdir(dirname)

    def _get_units(self, path):
        units = {}

        with open(path) as file:
            lines = file.readlines()

        for line in lines:
            line = line.strip("\n")
            key, val = line.split(":")
            units.update({key.strip(" "): val.strip(" ")})
        return units

    def getall(self, taskid):
        filebin = "/".join([self.pathbase, taskid, self._bin_suffix_path])
        unitbin = self._get_units(filebin)
        self.unitpgn = self.get(taskid)
        return { 'id' : taskid, **unitbin, **self.unitpgn}

    def get(self, taskid):
        filepgn = "/".join([self.pathbase, taskid, self._pgn_suffix_path])
        if os.path.exists(filepgn):
            return self._get_units(filepgn)
        return {}

    def set(self, units):
        for key, val in units.items():
            self.unitpgn[key] = val

    def save(self, taskid):
        filepgn = "/".join([self.pathbase, taskid, self._pgn_suffix_path])
        with open(filepgn, 'w') as file:
            for key, val in self.unitpgn.items():
                file.write(f"{key}: {val}\n")

class TecArgs(Log):
    def __init__(self, taskbase):
        self.taskbase = taskbase
        self.env = None
        self.desk = None
        self.taskid = None
        self.path_suffix = ".tec/toggles"

    # TODO: handle case when toggle file is empty
    def _get_env(self, env):
        if env:
            self.env = env
            return True

        file = "/".join([self.taskbase, self.path_suffix])
        with open(file) as file:
            lines = file.readlines()

        # TODO: add a better parser cuz ' :' might not get parsed
        value = lines[0].strip().partition(' : ')[-1]
        self.env = value
        return True

    # TODO: handle case when toggle file is empty
    def _get_desk(self, env, desk):
        if desk:
            self.desk = desk
            return True

        fname = "/".join([self.taskbase, env, self.path_suffix])
        with open(fname) as file:
            lines = file.readlines()

        # TODO: add a better parser cuz ' :' might not get parsed
        value = lines[0].strip().partition(' : ')[-1]
        self.desk = value
        return True

    def get(self, env, desk):
        if self._get_env(env) is False:
            self.err("'%s': no current env", "CURR")
            return False
        elif self.env_exist() is False:
            self.err("'%s': no such env", self.env)
            return False
        elif self._get_desk(self.env, desk) is False:
            self.err("'%s': no current desk", self.desk)
            return False
        elif self.desk_exist() is False:
            self.err("'%s': no such desk", self.desk)
            return False

    # TODO: use class Unit()
    def get_curr_taskID(self):
        lines = []
        fname = "/".join([self.taskbase, self.env, self.desk, self.path_suffix])

        # Current task ID might not exist, and it is fine
        if os.path.exists(fname):
            with open(fname) as file:
                lines = file.readlines()

        if len(lines) > 0:
            # TODO: add a better parser cuz ' :' might not get parsed
            value = lines[0].strip().partition(' : ')[-1]
            self.taskid = value
            return value
        return None

    def env_exist(self):
        dir = "/".join([self.taskbase, self.env])
        return os.path.exists(dir)

    def desk_exist(self):
        dir = "/".join([self.taskbase, self.env, self.desk])
        return os.path.exists(dir)

    def task_exist(self, taskid):
        dir = "/".join([self.taskbase, self.env, self.desk, taskid])
        return os.path.exists(dir)

class Gmux(Repo):
    def __init__(self, taskbase, env, desk, taskids, message=None):
        self.log = Log()
        self.taskids = taskids
        self.taskbase = taskbase
        self.message = message
        self.suffix_dir = ".tec/pgn"
        self.suffix_unit = self.suffix_dir + "/" + "gmux"
        self.args = TecArgs(self.taskbase)

        if self.args.get(env, desk) is False:
            sys.exit(1)

        global COMMAND
        if len(self.taskids) == 0 and COMMAND != 'help':
            if (taskid := self.args.get_curr_taskID()) is None:
                self.log.err("'%s': no current task ID", "CURR")
                sys.exit(1)
            self.taskids.append(taskid)
        # NOTE: args values need to be parsed first (it's done above)
        self.settings = Config().get(self.args.env)

    def _getpath(self):
        return "/".join([self.args.taskbase, self.args.env, self.args.desk])

    def commit(self):
        if not self.message:
            self.log.err("commit message is required, use -m")
            return GMUX_FAILURE

        retcode = True
        dst = self._getpath()
        unit = Unit(dst)
        repo = Repo(self.settings, self.args.taskbase)

        for taskid in self.taskids:
            if self.args.task_exist(taskid) is False:
                retcode = False
                self.log.err("'%s': no such task ID", taskid)
                continue

            units = unit.getall(taskid)
            branch_stored = units.get('branch')

            if branch_stored is None:
                retcode = False
                self.log.err("'%s': no task branch stored yet, run 'sync' first", taskid)
                continue

            for cfg in self.settings['repos']:
                if repo.symlink(cfg, dst, taskid) is False:
                    retcode = False
                    self.log.err("'%s': could not create symlink", cfg['name'])
                    continue

                if repo.has_uncommited_changes(cfg) == False:
                    self.log.info("'%s': nothing to commit", cfg['name'])
                elif repo.branch_switch(cfg, branch_stored) == False:
                    retcode = False
                    self.log.err("'%s': could not switch to task branch", cfg['name'])
                elif repo.commit(cfg, taskid, cfg['name'], self.message) == False:
                    retcode = False
                    self.log.err("'%s': could not commit changes", cfg['name'])

                for subcfg in repo.submodule_cfgs(cfg):
                    if repo.has_uncommited_changes(subcfg) == False:
                        continue
                    elif repo.branch_switch(subcfg, branch_stored) == False:
                        retcode = False
                        self.log.err("'%s': could not switch submodule to task branch", subcfg['name'])
                    elif repo.commit(subcfg, taskid, subcfg['subpath'], self.message) == False:
                        retcode = False
                        self.log.err("'%s': could not commit submodule changes", subcfg['name'])
                    elif repo.commit_submodule_pointer(cfg, subcfg) == False:
                        retcode = False
                        self.log.err("'%s': could not commit submodule pointer update", subcfg['name'])
        return GMUX_SUCCESS if retcode == True else GMUX_FAILURE

    def remove(self):
        retcode = True
        dst = self._getpath()
        unit = Unit(dst)
        repo = Repo(self.settings, self.args.taskbase)

        for taskid in self.taskids:
            if self.args.task_exist(taskid) is False:
                retcode = False
                self.log.err("'%s': no such task ID", taskid)
                continue

            units = unit.getall(taskid)
            branch_stored = units.get('branch')

            for cfg in self.settings['repos']:
                if repo.symlink(cfg, dst, taskid) is False:
                    retcode = False
                    self.log.err("'%s': could not create symlink", cfg['name'])
                    continue

                # Read submodules before removing the parent's task branch,
                # since that switches the parent back to its default branch
                # and may change (or drop) which submodules are checked out.
                for subcfg in repo.submodule_cfgs(cfg):
                    if repo.branch_remove(subcfg, branch_stored) == False:
                        retcode = False
                        self.log.err("'%s': could not remove submodule task branch", subcfg['name'])

                if repo.branch_remove(cfg, branch_stored) == False:
                    retcode = False
                    self.log.err("'%s': could not remove task branch", cfg['name'])
        return GMUX_SUCCESS if retcode == True else GMUX_FAILURE

    def help(self):
        retcode = 1
        cmds = self.taskids # these are commands not task IDs
        opts = {
                'synop' : True,
                'desc_short': True,
                'desc_long': True,
            }

        if len(cmds) == 0:
            for cmd in helpmsg:
                print(cmd, "\t", helpmsg[cmd]['desc_short'])
            return 0

        for cmd in cmds:
            _cmd = helpmsg.get(cmd)
            if _cmd is not None:
                print(_cmd['synop'])
                print("    ", _cmd['desc_short'])
                print("    ", _cmd['desc_long'])
                retcode = 0
            else:
                print(f"gmux: help: no such command '{cmd}'")
                retcode = 1
        return retcode

    def show(self):
        retcode = True
        unit = Unit(self._getpath())

        for taskid in self.taskids:
            if self.args.task_exist(taskid) is False:
                retcode = False
                self.log.err("'%s': no such task ID", taskid)
                continue

            units = unit.get(taskid)
            for key, value in units.items():
                print(f"{key} : {value}")
        return GMUX_SUCCESS if retcode == True else GMUX_FAILURE

    def sync(self):
        retcode = True
        dst = self._getpath()
        unit = Unit(dst)
        branch = Branch(self.settings['branchpatt'])
        repo = Repo(self.settings, self.args.taskbase)

        for taskid in self.taskids:
            if self.args.task_exist(taskid) is False:
                retcode = False
                self.log.err("'%s': no such task ID", taskid)
                continue

            unit.make_dir(taskid)
            units = unit.getall(taskid)
            branch_stored = units.get('branch')
            branch_generated = branch.generate(units, self.settings['prefix'], self.settings['type'])

            for cfg in self.settings['repos']:
                if repo.symlink(cfg, dst, taskid) is False:
                    retcode = False
                    self.log.err("'%s': could not create symlink", cfg['name'])
                elif repo.has_uncommited_changes(cfg) == True:
                    retcode = False
                    self.log.err("'%s': repo has uncommited changes", cfg['name'])
                elif repo.branch_update(cfg, branch_stored, branch_generated) is False:
                    self.log.err("'%s': could not update branch", cfg['name'])
                    retcode = False
                elif repo.branch_switch(cfg, branch_generated) == False:
                    self.log.err("'%s': could not switch to task branch", cfg['name'])
                    retcode = False
                elif repo.merge(cfg) == False:
                    self.log.err("'%s': could not merge branch", cfg['name'])
                    retcode = False
                else:
                    for subcfg in repo.submodule_cfgs(cfg):
                        if repo.has_uncommited_changes(subcfg) == True:
                            retcode = False
                            self.log.err("'%s': submodule has uncommited changes", subcfg['name'])
                        elif repo.branch_update(subcfg, branch_stored, branch_generated) is False:
                            retcode = False
                            self.log.err("'%s': could not update submodule branch", subcfg['name'])
                        elif repo.branch_switch(subcfg, branch_generated) == False:
                            retcode = False
                            self.log.err("'%s': could not switch submodule to task branch", subcfg['name'])
                        elif repo.merge(subcfg) == False:
                            retcode = False
                            self.log.err("'%s': could not merge submodule branch", subcfg['name'])
                        elif repo.commit_submodule_pointer(cfg, subcfg) == False:
                            retcode = False
                            self.log.err("'%s': could not commit submodule pointer update", subcfg['name'])

            if retcode == True and branch_stored != branch_generated:
                unit.set({ 'branch' : branch_generated })
                unit.save(taskid)

        return GMUX_SUCCESS if retcode == True else GMUX_FAILURE

    def rsync(self):
        retcode = True
        dst = self._getpath()
        unit = Unit(dst)
        branch = Branch(self.settings['branchpatt'])
        repo = Repo(self.settings, self.args.taskbase)

        for taskid in self.taskids:
            if self.args.task_exist(taskid) is False:
                retcode = False
                self.log.err("'%s': no such task ID", taskid)
                continue

            unit.make_dir(taskid)
            units = unit.getall(taskid)
            branch_generated = branch.generate(units, self.settings['prefix'], self.settings['type'])

            for cfg in self.settings['repos']:
                if repo.symlink(cfg, dst, taskid) is False:
                    retcode = False
                    self.log.err("'%s': could not create symlink", cfg['name'])
                elif repo.has_uncommited_changes(cfg) == True:
                    retcode = False
                    self.log.err("'%s': repo has uncommited changes", cfg['name'])
                elif repo.branch_switch_default(cfg) is False:
                    self.log.err("'%s': could not switch to default branch", cfg['name'])
                    retcode = False
                elif repo.fetch(cfg) == False:
                    self.log.err("'%s': could not fetch changes", cfg['name'])
                    retcode = False
                elif repo.merge(cfg) == False:
                    self.log.err("'%s': could not merge to default branch", cfg['name'])
                    retcode = False
                elif repo.rebase(cfg, cfg['branch'], branch_generated) == False:
                    self.log.err("'%s': could not rebase task branch against default branch", cfg['name'])
                    retcode = False
                else:
                    for subcfg in repo.submodule_cfgs(cfg):
                        if repo.has_uncommited_changes(subcfg) == True:
                            retcode = False
                            self.log.err("'%s': submodule has uncommited changes", subcfg['name'])
                        elif repo.branch_switch_default(subcfg) is False:
                            retcode = False
                            self.log.err("'%s': could not switch submodule to default branch", subcfg['name'])
                        elif repo.fetch(subcfg) == False:
                            retcode = False
                            self.log.err("'%s': could not fetch submodule changes", subcfg['name'])
                        elif repo.merge(subcfg) == False:
                            retcode = False
                            self.log.err("'%s': could not merge submodule to default branch", subcfg['name'])
                        elif repo.rebase(subcfg, subcfg['branch'], branch_generated) == False:
                            retcode = False
                            self.log.err("'%s': could not rebase submodule task branch against default branch", subcfg['name'])
                        elif repo.commit_submodule_pointer(cfg, subcfg) == False:
                            retcode = False
                            self.log.err("'%s': could not commit submodule pointer update", subcfg['name'])
        return GMUX_SUCCESS if retcode == True else GMUX_FAILURE


    def update(self):
        retcode = True
        dst = self._getpath()
        unit = Unit(dst)
        repo = Repo(self.settings, self.args.taskbase)

        for taskid in self.taskids:
            if self.args.task_exist(taskid) is False:
                retcode = False
                self.log.err("'%s': no such task ID", taskid)
                continue

            unit.make_dir(taskid)
            units = unit.getall(taskid)
            branch_stored = units.get('branch')

            if branch_stored is None:
                retcode = False
                self.log.err("'%s': no task branch stored yet, run 'sync' first", taskid)
                continue

            for cfg in self.settings['repos']:
                if repo.symlink(cfg, dst, taskid) is False:
                    retcode = False
                    self.log.err("'%s': could not create symlink", cfg['name'])
                elif repo.has_uncommited_changes(cfg) == True:
                    retcode = False
                    self.log.err("'%s': repo has uncommited changes", cfg['name'])
                elif repo.rebase(cfg, cfg['branch'], branch_stored) == False:
                    retcode = False
                    self.log.err("'%s': could not rebase against default branch", cfg['name'])
                else:
                    # Rebase/fast-forward/commit-pointer every submodule
                    # *before* fast-forwarding the parent's default branch,
                    # so the pointer bump is already part of the task branch
                    # by the time the parent's default branch is caught up
                    # to it.
                    submodules_ok = True
                    for subcfg in repo.submodule_cfgs(cfg):
                        if repo.has_uncommited_changes(subcfg) == True:
                            submodules_ok = False
                            self.log.err("'%s': submodule has uncommited changes", subcfg['name'])
                        elif repo.rebase(subcfg, subcfg['branch'], branch_stored) == False:
                            submodules_ok = False
                            self.log.err("'%s': could not rebase submodule against default branch", subcfg['name'])
                        elif repo.branch_fastforward(subcfg, branch_stored) == False:
                            submodules_ok = False
                            self.log.err("'%s': could not merge submodule task branch into default", subcfg['name'])
                        elif repo.commit_submodule_pointer(cfg, subcfg) == False:
                            submodules_ok = False
                            self.log.err("'%s': could not commit submodule pointer update", subcfg['name'])

                    if submodules_ok is False:
                        retcode = False
                    elif repo.branch_fastforward(cfg, branch_stored) == False:
                        retcode = False
                        self.log.err("'%s': could not merge task branch into default", cfg['name'])
                    elif repo.branch_switch(cfg, branch_stored) == False:
                        retcode = False
                        self.log.err("'%s': could not switch to task branch", cfg['name'])
        return GMUX_SUCCESS if retcode == True else GMUX_FAILURE

    def issue(self):
        print("manage MRs")


def parse_args():
    global COMMAND, ISDEBUG

    valid_cmds = list(helpmsg.keys()) + ['help']

    parser = argparse.ArgumentParser(description="Git multiplexer")
    parser.add_argument("-e", "--env", help="environment name")
    parser.add_argument("-d", "--desk", help="desk name")
    parser.add_argument("-P", "--pgnbase", help="pgn directory base")
    parser.add_argument("-T", "--taskbase", help="task directory base")
    parser.add_argument("-m", "--message", help="commit message")
    parser.add_argument("-v", "--verbose", action="store_true", help="verbose mode")
    parser.add_argument("cmd", default=default_cmd, nargs='?', type=str,
                         choices=valid_cmds, help="subcommand")
    parser.add_argument("taskids", type=str, nargs='*', help="task ID")
    args = parser.parse_args()

    # HOTFIX
    COMMAND = args.cmd
    ISDEBUG = args.verbose
    return args

def main():
    log = Log()
    args = parse_args()
    gmux = Gmux(args.taskbase, args.env, args.desk, args.taskids, args.message)
    cmd = getattr(gmux, args.cmd, None)

    if cmd is not None:
        res = cmd()
    else:
        res = log.err(f"'{args.cmd}': no such command")
    return res

sys.exit(main())
